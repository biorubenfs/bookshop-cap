# Copia este fichero a http/.env y rellénalo. http/.env no se sube a git.
#
# URL de srv:      cf app bookshop-srv          (línea "routes", con https://)
# Credenciales:    cf create-service-key bookshop-auth rest-client-key
#                  cf service-key bookshop-auth rest-client-key
#                  → campos clientid, clientsecret y url

SRV_URL=https://xxxx-dev-bookshop-srv.cfapps.us10-001.hana.ondemand.com
XSUAA_URL=https://xxxxtrial.authentication.us10.hana.ondemand.com
XSUAA_CLIENTID=sb-bookshop!t00000
XSUAA_CLIENTSECRET=pon-aqui-el-secreto
